{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Butter",
  "scopeName": "source.butter",
  "fileTypes": ["butter"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.butter",
          "match": "#.*$"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.butter",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.butter",
          "match": "\\\\(n|t|\\\\|\")"
        },
        {
          "name": "invalid.illegal.unrecognized-escape.butter",
          "match": "\\\\."
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.butter",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.butter",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.butter",
          "match": "\\b(if|else|while|for|in|try|catch|return|exit)\\b"
        },
        {
          "name": "keyword.control.import.butter",
          "match": "\\b(import|export)\\b"
        },
        {
          "name": "keyword.operator.logical.butter",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "storage.type.function.butter",
          "match": "\\bfunc\\b"
        },
        {
          "name": "storage.type.butter",
          "match": "\\b(int|float|bool|string|map|list|struct|enum)\\b"
        },
        {
          "name": "keyword.other.mode.butter",
          "match": "\\bappend\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.butter",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.butter",
          "match": "\\bnull\\b"
        },
        {
          "name": "support.constant.stream.butter",
          "match": "\\b(stdin|stdout|stderr)\\b"
        },
        {
          "name": "support.constant.args.butter",
          "match": "\\bargs\\b"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.butter",
          "match": "\\b(print|len|read|write|open|close|push|keys|has|delete|json|stringify|getenv|hasenv|exists|listDir|remove|rename|exec|now|random)\\b"
        },
        {
          "name": "entity.name.function.butter",
          "match": "(?<=\\bfunc\\s)[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.type.butter",
          "match": "(?<=\\b(struct|enum)\\s)[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.function.butter",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\()"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "comment": "PascalCase identifiers: user-declared struct/enum type references and EnumName.Variant",
          "name": "entity.name.type.butter",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.butter",
          "match": ":="
        },
        {
          "name": "keyword.operator.arrow.butter",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.butter",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.butter",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.arithmetic.exponent.butter",
          "match": "\\*\\*"
        },
        {
          "name": "keyword.operator.comparison.butter",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.arithmetic.butter",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.logical.not.butter",
          "match": "!"
        },
        {
          "name": "punctuation.separator.colon.butter",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.butter",
          "match": ","
        },
        {
          "name": "punctuation.accessor.butter",
          "match": "\\."
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.braces.butter",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.butter",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.butter",
          "match": "[()]"
        }
      ]
    }
  }
}
