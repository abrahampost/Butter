# Set, Stack, and Queue — three collections, each a struct wrapping a
# `map` that holds its actual contents.
#
# Set   — membership only. An element's presence is a key in `items`
#          (the value at that key is unused); this is why Set elements
#          are `string`, the only type a map key can be.
# Stack — LIFO, string elements, `items` keyed "0".."n-1". `len(items)` is
#          always the current size, since those keys are always
#          contiguous from 0 — no separate size field needed.
# Queue — FIFO, string elements. Unlike Stack, dequeuing drops the
#          *front* key, so the live keys in `items` aren't contiguous
#          from 0 over time; `head`/`tail` fields (real `int`s, not
#          string-keyed map entries) track the window of valid slots.
#
# Popping/peeking/dequeuing an empty collection raises the same
# `RuntimeError.KeyNotFound` a plain missing-key map read would — guard
# with the *IsEmpty functions first, same as you'd guard a map with `has`.

# ---- Set --------------------------------------------------------------

export struct Set {
    map items
}

export func setNew() -> Set {
    return Set{items: {}}
}

export func setHas(Set s, string item) -> bool {
    return has(s.items, item)
}

export func setAdd(Set s, string item) -> bool {
    if has(s.items, item) {
        return false
    }
    s.items[item] := true
    return true
}

export func setRemove(Set s, string item) -> bool {
    return delete(s.items, item)
}

export func setSize(Set s) -> int {
    return len(s.items)
}

export func setIsEmpty(Set s) -> bool {
    return len(s.items) == 0
}

export func setToList(Set s) -> list {
    return keys(s.items)
}

export func setUnion(Set a, Set b) -> Set {
    map result := {}
    list aKeys := keys(a.items)
    for i in 0..len(aKeys) {
        result[aKeys[i]] := true
    }
    list bKeys := keys(b.items)
    for i in 0..len(bKeys) {
        result[bKeys[i]] := true
    }
    return Set{items: result}
}

export func setIntersection(Set a, Set b) -> Set {
    map result := {}
    list aKeys := keys(a.items)
    for i in 0..len(aKeys) {
        if has(b.items, aKeys[i]) {
            result[aKeys[i]] := true
        }
    }
    return Set{items: result}
}

export func setDifference(Set a, Set b) -> Set {
    map result := {}
    list aKeys := keys(a.items)
    for i in 0..len(aKeys) {
        if !has(b.items, aKeys[i]) {
            result[aKeys[i]] := true
        }
    }
    return Set{items: result}
}

export func setIsSubset(Set a, Set b) -> bool {
    list aKeys := keys(a.items)
    for i in 0..len(aKeys) {
        if !has(b.items, aKeys[i]) {
            return false
        }
    }
    return true
}

export func setEquals(Set a, Set b) -> bool {
    return setIsSubset(a, b) and setIsSubset(b, a)
}

# ---- Stack (LIFO) -------------------------------------------------------

export struct Stack {
    map items
}

export func stackNew() -> Stack {
    return Stack{items: {}}
}

export func stackPush(Stack s, string item) -> int {
    s.items[stringify(len(s.items))] := item
    return len(s.items)
}

export func stackPop(Stack s) -> string {
    string topKey := stringify(len(s.items) - 1)
    string item := s.items[topKey]
    delete(s.items, topKey)
    return item
}

export func stackPeek(Stack s) -> string {
    return s.items[stringify(len(s.items) - 1)]
}

export func stackSize(Stack s) -> int {
    return len(s.items)
}

export func stackIsEmpty(Stack s) -> bool {
    return len(s.items) == 0
}

# ---- Queue (FIFO) -------------------------------------------------------

export struct Queue {
    map items,
    int head,
    int tail
}

export func queueNew() -> Queue {
    return Queue{items: {}, head: 0, tail: 0}
}

export func queueSize(Queue q) -> int {
    return q.tail - q.head
}

export func queueIsEmpty(Queue q) -> bool {
    return queueSize(q) == 0
}

export func queueEnqueue(Queue q, string item) -> int {
    q.items[stringify(q.tail)] := item
    q.tail := q.tail + 1
    return queueSize(q)
}

export func queueDequeue(Queue q) -> string {
    string frontKey := stringify(q.head)
    string item := q.items[frontKey]
    delete(q.items, frontKey)
    q.head := q.head + 1
    return item
}

export func queuePeek(Queue q) -> string {
    return q.items[stringify(q.head)]
}
