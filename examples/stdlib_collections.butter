import "collections.std.butter"

Set a := setNew()
a.add("x")
a.add("y")
Set b := setNew()
b.add("y")
b.add("z")

print a.contains("x")
print a.union(b).size()
print a.intersection(b).size()
print a.difference(b).size()
print a.equals(a)
print a.equals(b)

Stack st := stackNew()
st.add("one")
st.add("two")
st.add("three")
print st.pop()
print st.pop()
print st.size()

Queue q := queueNew()
q.enqueue("one")
q.enqueue("two")
q.enqueue("three")
print q.dequeue()
print q.dequeue()
print q.size()
