# Configuration from the environment: the shape a real CLI tool uses — a
# built-in default that an environment variable overrides, plus `hasenv`
# for the settings whose mere presence is the signal.

string editor := "nano"
if hasenv("EDITOR") {
    editor := getenv("EDITOR")
}
print "editor: " + editor

string pager := "less"
if hasenv("PAGER") {
    pager := getenv("PAGER")
}
print "pager: " + pager

# Set-but-empty is a real setting, not an absence — and only `hasenv` can
# tell the two apart, since `getenv` reads both as "".
print "QUIET set: " + stringify(hasenv("QUIET"))
print "QUIET value: [" + getenv("QUIET") + "]"
print "MISSING set: " + stringify(hasenv("MISSING"))
print "MISSING value: [" + getenv("MISSING") + "]"

# A numeric setting still arrives as text, so it goes through int(...).
int width := 80
if hasenv("BUTTER_WIDTH") {
    width := int(getenv("BUTTER_WIDTH"))
}
print "width doubled: " + stringify(width * 2)

# The name is an ordinary expression, not a literal, so a whole prefixed
# namespace of settings can be swept in a loop.
list settings := ["WIDTH", "DEPTH"]
for i in 0..len(settings) {
    string key := "BUTTER_" + settings[i]
    if hasenv(key) {
        print key + "=" + getenv(key)
    } else {
        print key + " unset"
    }
}

# What comes back is an ordinary string: it concatenates, measures, slices,
# and compares like any other.
string home := getenv("HOME")
print len(home)
print home[0..5]
print home > "/etc"
