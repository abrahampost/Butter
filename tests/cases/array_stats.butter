func sum(int[] arr) -> int {
    int total := 0
    for i in 0..len(arr) {
        total := total + arr[i]
    }
    return total
}

func minOf(int[] arr) -> int {
    int m := arr[0]
    for i in 1..len(arr) {
        if arr[i] < m {
            m := arr[i]
        }
    }
    return m
}

func maxOf(int[] arr) -> int {
    int m := arr[0]
    for i in 1..len(arr) {
        if arr[i] > m {
            m := arr[i]
        }
    }
    return m
}

int[6] data := [4, 8, 15, 16, 23, 42]
int total := sum(data)
float average := total / 6.0

print total
print average
print minOf(data)
print maxOf(data)
