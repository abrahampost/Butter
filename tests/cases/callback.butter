func isEven(int n) -> bool {
    return n % 2 == 0
}

func countMatching(list xs, func(int) bool pred) -> int {
    int count := 0
    for i in 0..len(xs) {
        if pred(xs[i]) {
            count := count + 1
        }
    }
    return count
}

func(int) bool matcher := isEven

print countMatching([1, 2, 3, 4, 5, 6], matcher)
print countMatching([1, 2, 3, 4, 5, 6], isEven)
